{
  "_title": "Portfolio Bento",
  "_rawnaq_version": "1.0.0",
  "elements": [
    {
      "id": "rk-bento-section",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "background_background": "classic",
        "background_color": "#050505",
        "padding": { "unit": "px", "top": "100", "right": "60", "bottom": "100", "left": "60", "isLinked": false }
      },
      "elements": [
        {
          "id": "rk-bento-col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "rk-bento-kicker",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Our Work",
                "header_size": "h6",
                "align": "center",
                "title_color": "#a855f7",
                "typography_font_size": { "unit": "px", "size": 13 },
                "typography_letter_spacing": { "unit": "em", "size": 0.25 },
                "typography_text_transform": "uppercase"
              }
            },
            {
              "id": "rk-bento-heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Selected Projects",
                "header_size": "h2",
                "align": "center",
                "title_color": "#ffffff",
                "typography_font_size": { "unit": "px", "size": 42 },
                "typography_font_weight": "700",
                "margin": { "unit": "px", "top": "12", "bottom": "48", "isLinked": false }
              }
            },
            {
              "id": "rk-bento-widget",
              "elType": "widget",
              "widgetType": "rawnaq-bento-grid",
              "settings": {
                "preset": "featured",
                "gap": 16,
                "cells": [
                  { "type": "featured", "title": "Brand Identity", "subtitle": "Full visual system for a SaaS startup", "badge": "Branding" },
                  { "type": "stat",     "title": "120+", "subtitle": "Projects shipped" },
                  { "type": "image",    "title": "E-Commerce Redesign", "badge": "Web" },
                  { "type": "stat",     "title": "98%", "subtitle": "Client satisfaction" },
                  { "type": "default",  "title": "SEO Growth Campaign", "subtitle": "3× organic traffic in 6 months" }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
