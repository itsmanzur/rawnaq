{
  "_title": "Process Flow",
  "_rawnaq_version": "1.0.0",
  "elements": [
    {
      "id": "rk-flow-section",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "background_background": "classic",
        "background_color": "{{COLOR_DARK}}",
        "padding": { "unit": "px", "top": "100", "right": "60", "bottom": "100", "left": "60", "isLinked": false }
      },
      "elements": [
        {
          "id": "rk-flow-col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "rk-flow-kicker",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "How We Work",
                "header_size": "h6",
                "align": "center",
                "title_color": "{{COLOR_WARNING}}",
                "typography_font_size": { "unit": "px", "size": 13 },
                "typography_letter_spacing": { "unit": "em", "size": 0.25 },
                "typography_text_transform": "uppercase"
              }
            },
            {
              "id": "rk-flow-heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Our Process",
                "header_size": "h2",
                "align": "center",
                "title_color": "{{COLOR_LIGHT}}",
                "typography_font_size": { "unit": "px", "size": 42 },
                "typography_font_weight": "700",
                "margin": { "unit": "px", "top": "12", "bottom": "48", "isLinked": false }
              }
            },
            {
              "id": "rk-flow-widget",
              "elType": "widget",
              "widgetType": "rawnaq-flow-chart",
              "settings": {
                "connector_color": "{{COLOR_WARNING}}",
                "nodes": [
                  { "id": "1", "parent": "",  "label": "Discovery Call",     "sublabel": "Understand your goals" },
                  { "id": "2", "parent": "1", "label": "Proposal & Scope",   "sublabel": "Timeline + budget" },
                  { "id": "3", "parent": "2", "label": "Design Sprint",       "sublabel": "Wireframes & concepts" },
                  { "id": "4", "parent": "3", "label": "Development",         "sublabel": "Build & iterate" },
                  { "id": "5", "parent": "4", "label": "QA & Launch",         "sublabel": "Test, go live, monitor" }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
