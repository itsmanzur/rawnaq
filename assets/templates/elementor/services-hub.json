{
  "_title": "Services Hub",
  "_rawnaq_version": "1.0.0",
  "elements": [
    {
      "id": "rk-hub-section",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "background_background": "classic",
        "background_color": "{{COLOR_DARK}}",
        "padding": { "unit": "px", "top": "100", "right": "60", "bottom": "100", "left": "60", "isLinked": false }
      },
      "elements": [
        {
          "id": "rk-hub-col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "rk-hub-kicker",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "What We Do",
                "header_size": "h6",
                "align": "center",
                "title_color": "{{COLOR_PRIMARY}}",
                "typography_font_size": { "unit": "px", "size": 13 },
                "typography_letter_spacing": { "unit": "em", "size": 0.25 },
                "typography_text_transform": "uppercase"
              }
            },
            {
              "id": "rk-hub-heading",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "Our Services at a Glance",
                "header_size": "h2",
                "align": "center",
                "title_color": "{{COLOR_LIGHT}}",
                "typography_font_size": { "unit": "px", "size": 42 },
                "typography_font_weight": "700",
                "margin": { "unit": "px", "top": "12", "bottom": "48", "isLinked": false }
              }
            },
            {
              "id": "rk-hub-widget",
              "elType": "widget",
              "widgetType": "rawnaq-hub-diagram",
              "settings": {
                "center_title": "Rawnaq",
                "center_subtitle": "Digital Agency",
                "spoke_color": "{{COLOR_PRIMARY}}",
                "particle_color": "{{COLOR_PRIMARY}}",
                "nodes": [
                  { "label": "Strategy", "icon": "fas fa-chess" },
                  { "label": "Branding", "icon": "fas fa-paint-brush" },
                  { "label": "Web Design", "icon": "fas fa-desktop" },
                  { "label": "Development", "icon": "fas fa-code" },
                  { "label": "SEO", "icon": "fas fa-search" },
                  { "label": "Marketing", "icon": "fas fa-bullhorn" }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
