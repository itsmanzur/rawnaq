{
  "_title": "Agency Hero",
  "_rawnaq_version": "1.0.0",
  "elements": [
    {
      "id": "rk-hero-section",
      "elType": "section",
      "settings": {
        "layout": "full_width",
        "height": "min-height",
        "custom_height": { "unit": "vh", "size": 90 },
        "content_position": "middle",
        "background_background": "classic",
        "background_color": "#0a0a0a",
        "padding": { "unit": "px", "top": "80", "right": "60", "bottom": "80", "left": "60", "isLinked": false }
      },
      "elements": [
        {
          "id": "rk-hero-col",
          "elType": "column",
          "settings": { "_column_size": 100 },
          "elements": [
            {
              "id": "rk-hero-kicker",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "✦ Full-service digital agency",
                "header_size": "h6",
                "align": "center",
                "title_color": "#6366f1",
                "typography_font_size": { "unit": "px", "size": 14 },
                "typography_letter_spacing": { "unit": "em", "size": 0.2 },
                "typography_text_transform": "uppercase"
              }
            },
            {
              "id": "rk-hero-h1",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "title": "We Build Digital Experiences That Convert",
                "header_size": "h1",
                "align": "center",
                "title_color": "#ffffff",
                "typography_font_size": { "unit": "vw", "size": 5.5 },
                "typography_font_weight": "700",
                "margin": { "unit": "px", "top": "16", "bottom": "24", "isLinked": false }
              }
            },
            {
              "id": "rk-hero-desc",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p style=\"text-align:center;color:#a1a1aa;\">From strategy to launch — branding, web design, and growth marketing under one roof.</p>",
                "align": "center"
              }
            },
            {
              "id": "rk-hero-ctas",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "text": "See Our Work",
                "align": "center",
                "size": "lg",
                "background_color": "#6366f1",
                "border_radius": { "unit": "px", "size": 8 },
                "margin": { "unit": "px", "top": "32", "isLinked": false }
              }
            }
          ]
        }
      ]
    }
  ]
}
